// Family Expense Tracker - Prisma Schema
// Database: Vercel Postgres

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Enum for user roles within a family
enum UserRole {
    ADMIN // Creator of the family group, can manage members
    MEMBER // Regular family member
}

// Enum for transaction types
enum TransactionType {
    INCOME
    EXPENSE
}

// Enum for expense categories (expandable)
enum Category {
    FOOD
    TRANSPORT
    UTILITIES
    HEALTHCARE
    EDUCATION
    ENTERTAINMENT
    SHOPPING
    SALARY
    INVESTMENT
    OTHER
}

// FamilyGroup Model
// Represents a household/family unit that shares expense tracking
model FamilyGroup {
    id         String   @id @default(cuid())
    name       String // e.g., "The Smith Family"
    inviteCode String   @unique @default(cuid()) // Unique code for family members to join
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    // Relations
    members      User[]        @relation("FamilyMembers")
    transactions Transaction[] @relation("FamilyTransactions")

    @@index([inviteCode])
}

// User Model
// Represents individual family members with authentication
model User {
    id            String    @id @default(cuid())
    name          String
    email         String    @unique
    password      String // Hashed password (bcrypt)
    role          UserRole  @default(MEMBER)
    emailVerified DateTime?
    image         String? // Optional profile picture
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    // Family relationship (One user belongs to ONE family)
    familyGroupId String
    familyGroup   FamilyGroup @relation("FamilyMembers", fields: [familyGroupId], references: [id], onDelete: Cascade)

    // Transactions created by this user
    transactions Transaction[] @relation("UserTransactions")

    @@index([email])
    @@index([familyGroupId])
}

// Transaction Model
// Represents individual income/expense entries
model Transaction {
    id          String          @id @default(cuid())
    amount      Decimal         @db.Decimal(15, 0) // Monetary amount in VND (no decimals)
    description String
    type        TransactionType
    category    Category
    date        DateTime        @default(now()) // Transaction date
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    // Family association (which family this transaction belongs to)
    familyGroupId String
    familyGroup   FamilyGroup @relation("FamilyTransactions", fields: [familyGroupId], references: [id], onDelete: Cascade)

    // Creator tracking (who made this transaction)
    createdById String
    createdBy   User   @relation("UserTransactions", fields: [createdById], references: [id], onDelete: Cascade)

    @@index([familyGroupId, date])
    @@index([createdById])
    @@index([type])
    @@index([category])
}
