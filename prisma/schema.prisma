// Family Expense Tracker - Prisma Schema
// Database: Vercel Postgres

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Enum for user roles within a family
enum UserRole {
    ADMIN // Creator of the family group, can manage members
    MEMBER // Regular family member
}

// Enum for transaction types
enum TransactionType {
    INCOME
    EXPENSE
}

// Enum for debt status
enum DebtStatus {
    ACTIVE
    PAID
}

// FamilyGroup Model
// Represents a household/family unit that shares expense tracking
model FamilyGroup {
    id         String   @id @default(cuid())
    name       String
    inviteCode String   @unique @default(cuid())
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    members      User[]        @relation("FamilyMembers")
    transactions Transaction[] @relation("FamilyTransactions")
    categories   Category[]    @relation("FamilyCategories")
    budgets      Budget[]      @relation("FamilyBudgets")
    debts        Debt[]        @relation("FamilyDebts")

    @@index([inviteCode])
}

// User Model
model User {
    id            String    @id @default(cuid())
    name          String
    email         String    @unique
    password      String
    role          UserRole  @default(MEMBER)
    emailVerified DateTime?
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    familyGroupId String
    familyGroup   FamilyGroup @relation("FamilyMembers", fields: [familyGroupId], references: [id], onDelete: Cascade)

    transactions Transaction[] @relation("UserTransactions")

    @@index([email])
    @@index([familyGroupId])
}

// Category Model
model Category {
    id        String          @id @default(cuid())
    name      String
    type      TransactionType
    icon      String
    createdAt DateTime        @default(now())
    updatedAt DateTime        @updatedAt

    familyGroupId String
    familyGroup   FamilyGroup @relation("FamilyCategories", fields: [familyGroupId], references: [id], onDelete: Cascade)

    transactions Transaction[] @relation("CategoryTransactions")
    budgets      Budget[]      @relation("CategoryBudgets")

    @@index([familyGroupId])
    @@index([type])
}

// Transaction Model
model Transaction {
    id          String          @id @default(cuid())
    amount      Decimal         @db.Decimal(15, 0)
    description String
    type        TransactionType
    date        DateTime        @default(now())
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt

    categoryId String?
    category   Category? @relation("CategoryTransactions", fields: [categoryId], references: [id], onDelete: SetNull)

    familyGroupId String
    familyGroup   FamilyGroup @relation("FamilyTransactions", fields: [familyGroupId], references: [id], onDelete: Cascade)

    createdById String
    createdBy   User   @relation("UserTransactions", fields: [createdById], references: [id], onDelete: Cascade)

    @@index([familyGroupId, date])
    @@index([createdById])
    @@index([type])
    @@index([categoryId])
}

// Budget Model
// Stores monthly spending limits per category
model Budget {
    id     String  @id @default(cuid())
    amount Decimal @db.Decimal(15, 0)
    month  Int // 1-12
    year   Int

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    categoryId String
    category   Category @relation("CategoryBudgets", fields: [categoryId], references: [id], onDelete: Cascade)

    familyGroupId String
    familyGroup   FamilyGroup @relation("FamilyBudgets", fields: [familyGroupId], references: [id], onDelete: Cascade)

    @@unique([familyGroupId, categoryId, month, year])
    @@index([familyGroupId])
    @@index([categoryId])
}

// Debt Model
// Tracks money owed and repayment progress
model Debt {
    id              String     @id @default(cuid())
    title           String
    description     String?
    totalAmount     Decimal    @db.Decimal(15, 0)
    remainingAmount Decimal    @db.Decimal(15, 0)
    dueDate         DateTime?
    status          DebtStatus @default(ACTIVE)
    createdAt       DateTime   @default(now())
    updatedAt       DateTime   @updatedAt

    familyGroupId String
    familyGroup   FamilyGroup @relation("FamilyDebts", fields: [familyGroupId], references: [id], onDelete: Cascade)

    payments DebtPayment[] @relation("DebtPayments")

    @@index([familyGroupId])
    @@index([status])
}

// DebtPayment Model
// Tracks individual repayments for a debt
model DebtPayment {
    id        String   @id @default(cuid())
    amount    Decimal  @db.Decimal(15, 0)
    date      DateTime @default(now())
    createdAt DateTime @default(now())

    debtId String
    debt   Debt   @relation("DebtPayments", fields: [debtId], references: [id], onDelete: Cascade)

    @@index([debtId])
    @@index([date])
}
